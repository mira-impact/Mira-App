# Copie este arquivo para a RAIZ do projeto com o nome .env.local e preencha.
# (O .env.local já está no .gitignore: a chave nunca vai para o GitHub.)

# CAMINHO MAIS SIMPLES: uma chave só, do AI Gateway da Vercel, serve para o Jev E para o Gemini.
AI_GATEWAY_API_KEY=

# OPCIONAL: se você já usa uma chave do Google AI Studio na MIRA, o Gemini vai direto pelo Google
# (é o mesmo caminho do app). Se ficar vazia, o Gemini passa pelo AI Gateway.
GEMINI_API_KEY=

# OPCIONAL: só se você tiver conta na TypeSafe (novos cadastros estavam pausados em out/2026).
TYPESAFE_API_KEY=

# Modelos (deixe como está, a não ser que queira testar outro)
# GEMINI_MODEL=gemini-3.6-flash
# JEV_MODEL=typesafe-ai/jev

# Se o Gemini gratuito devolver erro 429 (limite), aumente a pausa entre histórias (em ms)
# EXPERIMENTO_PAUSA_MS=4000
