# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# IMPORTANTE: use um projeto COM FATURAMENTO ATIVO. No nível gratuito, o Google pode usar
# o que é enviado para melhorar os produtos dele, o que quebra o "não fica guardada" do combinado.
GEMINI_API_KEY=

# Modelo principal e reserva (o reserva é usado se o principal sair do ar).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_RESERVA=gemini-2.5-flash

# Pedidos de IA por IP a cada 10 minutos (proteção básica de custo).
LIMITE_POR_10MIN=30

# Só para desenvolver sem chave: respostas falsas por palavra-chave. Ignorado em produção.
# MIRA_IA_FALSA=1

# ---------- Conta opcional (Supabase) ----------
# Sem estas duas, a MIRA funciona só no celular (sem conta). Pegue em Supabase → Project Settings → API Keys.
# São públicas por natureza (vão para o navegador); quem protege os dados são as regras do supabase/schema.sql.
# NUNCA coloque aqui a chave "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Vagas coletadas de páginas de carreira (opcional) ----------
# Chave SECRETA do Supabase (Project Settings → API Keys → Secret key, começa com sb_secret_).
# Só o servidor usa, para gravar as vagas. NUNCA ponha NEXT_PUBLIC_ no nome nem cole no código.
SUPABASE_SECRET_KEY=
# Senha que a Vercel manda ao chamar a coleta diária. Invente uma longa (ex.: 40 letras e números).
CRON_SECRET=
# Página que identifica o robô da MIRA para os sites visitados (o endereço do app serve).
MIRA_CONTATO_URL=https://mira-alpha-one.vercel.app
# Quantas vagas novas o Gemini lê por dia (controle de custo).
COLETA_MAX_IA=30
